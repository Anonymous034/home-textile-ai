# 请把本文件复制为 backend/.env，再填写新生成的密钥。
# 不要把真实密钥提交到 Git，也不要把密钥放进前端代码。
ARK_API_KEY=replace_with_rotated_key
ARK_IMAGE_MODEL=doubao-seedream-5.0-lite
# Agent Plan 专属 Key 使用 /api/plan/v3；普通方舟 Key 使用 /api/v3。
ARK_IMAGE_ENDPOINT=https://ark.cn-beijing.volces.com/api/plan/v3/images/generations
# direct（默认）不继承系统/开发工具注入的代理；只有明确需要代理时改为 environment。
ARK_PROXY_MODE=direct
FRONTEND_ORIGIN=http://localhost:3000
# 仅本机配置窗口使用；公开服务器必须设为 0。
LOCAL_CONFIG_ENABLED=1

# 阿里云短信验证码：在服务器的 backend/.env 中填写真实配置，切勿提交密钥。
# 模板需要包含 ${code} 变量；签名须完成对应运营商的报备。
DEMO_SMS_MODE=aliyun
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
AUTH_OTP_PEPPER=
# 本机 HTTP 用 0；正式 HTTPS 服务器必须改为 1。
AUTH_COOKIE_SECURE=0

# 详情页文字策划：需支持图片输入和 messages/choices 格式的聊天接口。
# 请使用供应商给出的完整 HTTPS 接口地址、视觉模型 ID 和对应密钥。
# 不会默认使用图片生成密钥，也不会用本地模板冒充 AI 方案。
DETAIL_PLAN_ENDPOINT=
DETAIL_PLAN_MODEL=
DETAIL_PLAN_API_KEY=
# 文字策划默认直连，避免本机代理干扰；确实依赖系统代理时改为 environment。
DETAIL_PLAN_PROXY_MODE=direct

# 买家秀生活场景提示词策划（不会直接调用图像渲染器）。
# 三项均为空时复用完整的 DETAIL_PLAN_*；只填部分时不混用其他密钥。
# 上传图片需要支持视觉输入的 messages/choices 格式聊天模型。
BUYER_PLAN_ENDPOINT=
BUYER_PLAN_MODEL=
BUYER_PLAN_API_KEY=

# 支付宝电脑网站支付。未配置完整时自动保留本地模拟支付。
# 可选值：mock / sandbox / production。首次部署请保持 sandbox。
ALIPAY_MODE=mock
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY_FILE=secrets/alipay_app_private_key.pem
ALIPAY_PUBLIC_KEY_FILE=secrets/alipay_public_key.pem
ALIPAY_PUBLIC_BASE_URL=http://49.232.95.85
# 留空时根据 ALIPAY_MODE 自动选择官方沙箱或生产网关。
ALIPAY_GATEWAY_URL=
# 可选；填写后异步通知会额外核对收款方 PID。
ALIPAY_SELLER_ID=
