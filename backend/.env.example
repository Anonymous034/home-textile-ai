# 请把本文件复制为 backend/.env，再填写新生成的密钥。
# 不要把真实密钥提交到 Git，也不要把密钥放进前端代码。
ARK_API_KEY=replace_with_rotated_key
ARK_IMAGE_MODEL=doubao-seedream-5.0-lite
# Agent Plan 专属 Key 使用 /api/plan/v3；普通方舟 Key 使用 /api/v3。
ARK_IMAGE_ENDPOINT=https://ark.cn-beijing.volces.com/api/plan/v3/images/generations
# direct（默认）不继承系统/开发工具注入的代理；只有明确需要代理时改为 environment。
ARK_PROXY_MODE=direct
FRONTEND_ORIGIN=http://localhost:3000

# 详情页文字策划：需支持图片输入和 messages/choices 格式的聊天接口。
# 请使用供应商给出的完整 HTTPS 接口地址、视觉模型 ID 和对应密钥。
# 不会默认使用图片生成密钥，也不会用本地模板冒充 AI 方案。
DETAIL_PLAN_ENDPOINT=
DETAIL_PLAN_MODEL=
DETAIL_PLAN_API_KEY=
# 文字策划默认直连，避免本机代理干扰；确实依赖系统代理时改为 environment。
DETAIL_PLAN_PROXY_MODE=direct

# 买家秀生活场景提示词策划（不会直接调用图像渲染器）。
# 三项均为空时复用完整的 DETAIL_PLAN_*；只填部分时不混用其他密钥。
# 上传图片需要支持视觉输入的 messages/choices 格式聊天模型。
BUYER_PLAN_ENDPOINT=
BUYER_PLAN_MODEL=
BUYER_PLAN_API_KEY=
